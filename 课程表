<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>课程表 2.0</title>

<style>
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    display: flex;
    padding: 0;
    margin: 0;
  }
  #external-events {
    width: 300px;
    padding: 0 18px 24px;
    border-right: 1px solid #ddd;
    background-color: #f7f7f7;
    height: 100vh;
    overflow-y: auto;
  }
  #external-events h4 {
    margin-top: 20px;
    font-size: 16px;
    text-align: center;
  }
  #external-events .fc-event {
    margin: 10px 0;
    cursor: default;
    padding: 5px 8px;
    color: white;
    border-radius: 4px;
    font-size: 14px;
    text-shadow: 1px 1px 1px rgba(0,0,0,0.2);
  }
  #external-events .course-name {
    display: block;
    font-weight: 600;
  }
  #external-events .course-duration {
    display: block;
    margin-top: 2px;
    font-size: 12px;
    opacity: 0.9;
  }
  .course-form {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid #ddd;
  }
  .course-form h5 {
    margin: 0 0 12px;
    font-size: 15px;
  }
  .course-form label {
    display: block;
    margin-bottom: 5px;
    color: #495057;
    font-size: 13px;
    font-weight: 600;
  }
  .course-form input,
  .course-form select {
    box-sizing: border-box;
    width: 100%;
    min-height: 34px;
    padding: 6px 8px;
    border: 1px solid #ced4da;
    border-radius: 4px;
    font: inherit;
  }
  .course-form-field {
    margin-bottom: 12px;
  }
  .occurrence-list {
    display: grid;
    gap: 8px;
  }
  .occurrence-row {
    display: grid;
    grid-template-columns: 1.1fr 1fr .9fr auto;
    gap: 5px;
    align-items: end;
  }
  .occurrence-row label {
    margin: 0;
    font-size: 11px;
    font-weight: 500;
  }
  .occurrence-row input,
  .occurrence-row select {
    min-width: 0;
    min-height: 32px;
    padding: 4px;
    font-size: 13px;
  }
  .remove-occurrence,
  #add-occurrence-btn {
    min-height: 32px;
    border: 1px solid #ced4da;
    border-radius: 4px;
    background: #f8f9fa;
    color: #495057;
    cursor: pointer;
  }
  .remove-occurrence {
    width: 32px;
    padding: 0;
    font-size: 18px;
    line-height: 1;
  }
  #add-occurrence-btn {
    width: 100%;
    margin-top: 10px;
    padding: 6px;
  }
  #submit-course-btn {
    width: 100%;
    margin-top: 12px;
    padding: 9px;
    border: 0;
    border-radius: 4px;
    background: #4363d8;
    color: #fff;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
  }
  #submit-course-btn:hover {
    background: #3451bd;
  }
  .form-hint {
    margin: 8px 0 0;
    color: #6c757d;
    font-size: 12px;
    line-height: 1.4;
  }
  #calendar-container {
    flex-grow: 1;
    padding: 20px;
    height: 100vh;
    box-sizing: border-box;
    background-color: #fff;
  }
  #calendar {
    max-width: 1100px;
    margin: 0 auto;
  }
  .button-group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 15px;
  }
  #add-course-btn {
    grid-column: 1 / -1;
  }
  .button-group button, .button-group label {
    display: block;
    width: 100%;
    padding: 8px;
    background-color: #e9ecef;
    color: #495057;
    border: 1px solid #ced4da;
    border-radius: 4px;
    cursor: pointer;
    font-size: 14px;
    text-align: center;
    transition: background-color 0.2s, border-color 0.2s;
  }
  .button-group button:hover, .button-group label:hover {
    background-color: #dee2e6;
    border-color: #adb5bd;
  }
  .fc .fc-day-today {
    background-color: inherit !important;
  }

  .fc-timegrid-event .fc-event-title {
    font-size: 13px;
    line-height: 1.2;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .fc-timegrid-event .fc-event-time {
    font-size: 11px;
    line-height: 1.2;
    font-weight: 500;
  }
  .fc-timegrid-event .fc-event-main {
    padding: 2px 4px;
  }

</style>
</head>
<body>

<div id="external-events">
  <h4>课程管理</h4>

  <div class="button-group">
    <button id="add-course-btn" type="button">重置新增表单</button>
    <button id="export-btn">导出JSON</button>
    <label for="import-file" class="button-group-label">导入JSON</label>
    <input type="file" id="import-file" accept=".json" style="display: none;">
    <button id="save-image-btn">存为图片</button>
  </div>

  <div class="course-form" aria-labelledby="course-form-title">
    <h5 id="course-form-title">新增课程并安排课节</h5>
    <form id="add-course-form">
      <div class="course-form-field">
        <label for="course-name-input">课程名称</label>
        <input id="course-name-input" name="courseName" type="text" maxlength="40" required placeholder="例如：数学">
      </div>
      <div class="course-form-field">
        <label>上课时段</label>
        <div id="occurrence-list" class="occurrence-list"></div>
        <button id="add-occurrence-btn" type="button">+ 添加另一个时段</button>
        <p class="form-hint">同一门课可以在一周内或同一天安排多次。</p>
      </div>
      <button id="submit-course-btn" type="submit">添加课程并更新课程表</button>
    </form>
  </div>

  <h5 style="margin: 22px 0 8px;">课程列表</h5>
  <div id='external-events-list'>
    <div class='fc-event' title="双击可编辑" data-course-name="语文" data-duration-minutes="40">
      <span class="course-name">语文</span>
      <span class="course-duration">40 分钟</span>
    </div>
    <div class='fc-event' title="双击可编辑" data-course-name="数学" data-duration-minutes="40">
      <span class="course-name">数学</span>
      <span class="course-duration">40 分钟</span>
    </div>
    <div class='fc-event' title="双击可编辑" data-course-name="英语" data-duration-minutes="40">
      <span class="course-name">英语</span>
      <span class="course-duration">40 分钟</span>
    </div>
  </div>

</div>

<div id="calendar-container">
  <div id="calendar"></div>
</div>

<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.17/index.global.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>


<script>
  document.addEventListener('DOMContentLoaded', function() {
    var calendarEl = document.getElementById('calendar');
    var containerEl = document.getElementById('external-events-list');
    var addCourseBtn = document.getElementById('add-course-btn');
    var addCourseForm = document.getElementById('add-course-form');
    var courseNameInput = document.getElementById('course-name-input');
    var occurrenceList = document.getElementById('occurrence-list');
    var addOccurrenceBtn = document.getElementById('add-occurrence-btn');
    var exportBtn = document.getElementById('export-btn');
    var importFileEl = document.getElementById('import-file');
    var saveImageBtn = document.getElementById('save-image-btn');
    const DEFAULT_DURATION_MINUTES = 40;
    const STORAGE_KEY = 'classSchedule:v2';
    const LEGACY_STORAGE_KEY = 'classSchedule:v1';
    const REFERENCE_WEEK_START = '2026-01-05';
    const WEEKDAY_LABELS = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六'];

    // --- 【核心修改】扩展颜色库至24种 ---
    const courseColors = [
        '#e6194b', '#3cb44b', '#ffe119', '#4363d8', '#f58231', '#911eb4', '#46f0f0', '#f032e6',
        '#bcf60c', '#fabebe', '#008080', '#e6beff', '#9a6324', '#fffac8', '#800000', '#aaffc3',
        '#808000', '#ffd8b1', '#000075', '#808080', '#000000', '#1f77b4', '#ff7f0e', '#2ca02c'
    ];
    let courseColorMap = {};
    let courseDurationMap = {};
    let isLoadingData = false;

    // --- 【核心重构】全新的、保证颜色唯一的“颜色门卫”函数 ---
    function assignOrGetCourseColor(courseName) {
        // 如果该课程已经有颜色了，直接返回
        if (courseColorMap[courseName]) {
            return courseColorMap[courseName];
        }

        // 如果是新课程，需要分配一个新颜色
        const usedColors = Object.values(courseColorMap);

        // 1. 优先从预设颜色库里找一个没被用过的
        for (const color of courseColors) {
            if (!usedColors.includes(color)) {
                courseColorMap[courseName] = color;
                return color;
            }
        }

        // 2. 如果预设颜色都用完了（课程种类超过24种），则生成一个随机颜色作为备用
        let randomColor;
        do {
            randomColor = '#' + Math.floor(Math.random()*16777215).toString(16).padStart(6, '0');
        } while (usedColors.includes(randomColor)); // 确保随机色也不重复

        courseColorMap[courseName] = randomColor;
        return randomColor;
    }

    // --- 左侧列表的管理 ---
    function createCourseElement(name, color, durationMinutes) {
        const newCourseEl = document.createElement('div');
        const trimmedName = name.trim();
        const normalizedDuration = normalizeDurationMinutes(durationMinutes);

        newCourseEl.className = 'fc-event fc-h-event fc-daygrid-event fc-daygrid-block-event';
        newCourseEl.style.backgroundColor = color;
        newCourseEl.style.borderColor = color;
        newCourseEl.style.color = getContrastingTextColor(color);
        newCourseEl.dataset.color = color;
        newCourseEl.dataset.courseName = trimmedName;
        newCourseEl.dataset.durationMinutes = normalizedDuration;
        newCourseEl.title = '双击可编辑名称和时长';
        newCourseEl.innerHTML = '';

        const nameEl = document.createElement('span');
        nameEl.className = 'course-name';
        nameEl.innerText = trimmedName;

        const durationEl = document.createElement('span');
        durationEl.className = 'course-duration';
        durationEl.innerText = `${normalizedDuration} 分钟`;

        newCourseEl.appendChild(nameEl);
        newCourseEl.appendChild(durationEl);
        return newCourseEl;
    }

    function normalizeDurationMinutes(value) {
        const duration = Number.parseInt(value, 10);
        if (Number.isNaN(duration) || duration < 5) {
            return DEFAULT_DURATION_MINUTES;
        }
        if (duration > 240) {
            return 240;
        }
        return duration;
    }

    function formatDuration(minutes) {
        const hours = Math.floor(minutes / 60).toString().padStart(2, '0');
        const remainingMinutes = (minutes % 60).toString().padStart(2, '0');
        return `${hours}:${remainingMinutes}:00`;
    }

    function addMinutes(date, minutes) {
        return new Date(date.getTime() + minutes * 60 * 1000);
    }

    function padTimePart(value) {
        return value.toString().padStart(2, '0');
    }

    function formatTimeOnly(date) {
        return `${padTimePart(date.getHours())}:${padTimePart(date.getMinutes())}`;
    }

    function normalizeTimeValue(value) {
        if (typeof value !== 'string') {
            return null;
        }
        const match = value.trim().match(/^(\d{1,2}):(\d{2})(?::\d{2})?$/);
        if (!match) {
            return null;
        }
        const hours = Number.parseInt(match[1], 10);
        const minutes = Number.parseInt(match[2], 10);
        if (hours > 23 || minutes > 59) {
            return null;
        }
        return `${padTimePart(hours)}:${padTimePart(minutes)}`;
    }

    function normalizeHexColor(value) {
        if (typeof value !== 'string') {
            return null;
        }
        const match = value.trim().match(/^#([0-9a-f]{3}|[0-9a-f]{6})$/i);
        if (!match) {
            return null;
        }
        const hex = match[1].length === 3
            ? match[1].split('').map(part => part + part).join('')
            : match[1];
        return `#${hex.toLowerCase()}`;
    }

    function getContrastingTextColor(backgroundColor) {
        const normalizedColor = normalizeHexColor(backgroundColor);
        if (!normalizedColor) {
            return '#ffffff';
        }
        const channels = [0, 2, 4].map(index => parseInt(normalizedColor.slice(index + 1, index + 3), 16) / 255);
        const luminance = channels.map(channel => {
            return channel <= 0.03928 ? channel / 12.92 : Math.pow((channel + 0.055) / 1.055, 2.4);
        }).reduce((sum, channel, index) => sum + channel * [0.2126, 0.7152, 0.0722][index], 0);
        const whiteContrast = 1.05 / (luminance + 0.05);
        const darkContrast = (luminance + 0.05) / 0.05;
        return whiteContrast >= darkContrast ? '#ffffff' : '#17202a';
    }

    function getWeekdayIndex(value) {
        if (typeof value === 'number' && Number.isInteger(value)) {
            if (value >= 0 && value <= 6) {
                return value;
            }
            if (value >= 1 && value <= 7) {
                return value % 7;
            }
        }

        if (typeof value !== 'string') {
            return null;
        }

        const aliases = {
            '星期日': 0, '星期天': 0, '周日': 0, '周天': 0, '日': 0, '天': 0, 'sunday': 0, 'sun': 0,
            '星期一': 1, '周一': 1, '一': 1, 'monday': 1, 'mon': 1,
            '星期二': 2, '周二': 2, '二': 2, 'tuesday': 2, 'tue': 2,
            '星期三': 3, '周三': 3, '三': 3, 'wednesday': 3, 'wed': 3,
            '星期四': 4, '周四': 4, '四': 4, 'thursday': 4, 'thu': 4,
            '星期五': 5, '周五': 5, '五': 5, 'friday': 5, 'fri': 5,
            '星期六': 6, '周六': 6, '六': 6, 'saturday': 6, 'sat': 6
        };
        return aliases[value.trim().toLowerCase()] ?? null;
    }

    function buildReferenceDate(weekday, timeValue) {
        const weekdayIndex = getWeekdayIndex(weekday);
        const normalizedTime = normalizeTimeValue(timeValue);
        if (weekdayIndex === null || !normalizedTime) {
            return null;
        }

        const [hours, minutes] = normalizedTime.split(':').map(Number);
        const date = new Date(`${REFERENCE_WEEK_START}T00:00:00`);
        const offsetDays = weekdayIndex === 0 ? 6 : weekdayIndex - 1;
        date.setDate(date.getDate() + offsetDays);
        date.setHours(hours, minutes, 0, 0);
        return date;
    }

    function getEventStartDate(eventData) {
        if (eventData.weekday !== undefined && eventData.startTime) {
            return buildReferenceDate(eventData.weekday, eventData.startTime);
        }
        if (eventData.dayOfWeek !== undefined && eventData.startTime) {
            return buildReferenceDate(eventData.dayOfWeek, eventData.startTime);
        }
        if (eventData.start) {
            const start = new Date(eventData.start);
            return Number.isNaN(start.getTime()) ? null : start;
        }
        return null;
    }

    function getEventEndDate(eventData, startDate, durationMinutes) {
        const weekday = eventData.weekday ?? eventData.dayOfWeek;
        if (weekday !== undefined && eventData.endTime) {
            const end = buildReferenceDate(weekday, eventData.endTime);
            if (end) {
                if (startDate && end <= startDate) {
                    end.setDate(end.getDate() + 1);
                }
                return end;
            }
        }
        if (eventData.end) {
            const end = new Date(eventData.end);
            if (!Number.isNaN(end.getTime())) {
                return end;
            }
        }
        return startDate ? addMinutes(startDate, durationMinutes) : null;
    }

    function normalizeCalendarEvent(eventData, durationMinutes) {
        const start = getEventStartDate(eventData);
        if (!start) {
            return null;
        }
        const normalizedDuration = normalizeDurationMinutes(eventData.durationMinutes || durationMinutes);
        const end = getEventEndDate(eventData, start, normalizedDuration);
        return {
            title: eventData.title.trim(),
            start,
            end,
            durationMinutes: normalizedDuration
        };
    }

    function serializeCalendarEvent(event) {
        const start = event.start;
        const end = event.end || addMinutes(start, courseDurationMap[event.title] || DEFAULT_DURATION_MINUTES);
        const durationMinutes = Math.max(5, Math.round((end - start) / 60000));
        return {
            title: event.title,
            weekday: WEEKDAY_LABELS[start.getDay()],
            startTime: formatTimeOnly(start),
            endTime: formatTimeOnly(end),
            durationMinutes
        };
    }

    function getFirstEventStartDate(events) {
        const firstTimestamp = events
            .map(eventData => {
                const start = getEventStartDate(eventData);
                return start ? start.getTime() : NaN;
            })
            .filter(timestamp => !Number.isNaN(timestamp))
            .sort((a, b) => a - b)[0];

        return firstTimestamp === undefined ? null : new Date(firstTimestamp);
    }

    function getCourseNameFromElement(courseEl) {
        return courseEl.dataset.courseName || courseEl.querySelector('.course-name')?.innerText.trim() || courseEl.innerText.trim();
    }

    function getDurationFromElement(courseEl) {
        const courseName = getCourseNameFromElement(courseEl);
        return normalizeDurationMinutes(courseEl.dataset.durationMinutes || courseDurationMap[courseName]);
    }

    function promptCourseDuration(defaultDuration) {
        const answer = prompt('请输入课程时长（分钟，5-240）:', normalizeDurationMinutes(defaultDuration));
        if (answer === null) {
            return null;
        }
        return normalizeDurationMinutes(answer);
    }

    function createOccurrenceRow(defaults = {}) {
        const row = document.createElement('div');
        row.className = 'occurrence-row';

        const weekdayField = document.createElement('div');
        const weekdayLabel = document.createElement('label');
        weekdayLabel.innerText = '星期';
        const weekdaySelect = document.createElement('select');
        weekdaySelect.name = 'weekday';
        WEEKDAY_LABELS.forEach((label, index) => {
            const option = document.createElement('option');
            option.value = index;
            option.innerText = label;
            weekdaySelect.appendChild(option);
        });
        weekdaySelect.value = String(defaults.weekday ?? 1);
        weekdayField.append(weekdayLabel, weekdaySelect);

        const timeField = document.createElement('div');
        const timeLabel = document.createElement('label');
        timeLabel.innerText = '开始时间';
        const timeInput = document.createElement('input');
        timeInput.type = 'time';
        timeInput.name = 'startTime';
        timeInput.required = true;
        timeInput.value = defaults.startTime || '08:00';
        timeField.append(timeLabel, timeInput);

        const durationField = document.createElement('div');
        const durationLabel = document.createElement('label');
        durationLabel.innerText = '时长(分)';
        const durationInput = document.createElement('input');
        durationInput.type = 'number';
        durationInput.name = 'durationMinutes';
        durationInput.min = '5';
        durationInput.max = '240';
        durationInput.step = '1';
        durationInput.required = true;
        durationInput.value = defaults.durationMinutes || DEFAULT_DURATION_MINUTES;
        durationField.append(durationLabel, durationInput);

        const removeButton = document.createElement('button');
        removeButton.type = 'button';
        removeButton.className = 'remove-occurrence';
        removeButton.title = '删除这个时段';
        removeButton.innerText = '×';
        removeButton.addEventListener('click', function() {
            if (occurrenceList.children.length === 1) {
                timeInput.value = '08:00';
                durationInput.value = DEFAULT_DURATION_MINUTES;
                return;
            }
            row.remove();
        });

        row.append(weekdayField, timeField, durationField, removeButton);
        occurrenceList.appendChild(row);
    }

    function resetCourseForm() {
        addCourseForm.reset();
        occurrenceList.innerHTML = '';
        createOccurrenceRow();
    }

    function readOccurrenceRows() {
        return Array.from(occurrenceList.children).map(row => {
            const weekday = Number.parseInt(row.querySelector('[name="weekday"]').value, 10);
            const startTime = normalizeTimeValue(row.querySelector('[name="startTime"]').value);
            const durationMinutes = Number.parseInt(row.querySelector('[name="durationMinutes"]').value, 10);
            if (!Number.isInteger(weekday) || weekday < 0 || weekday > 6 || !startTime ||
                !Number.isInteger(durationMinutes) || durationMinutes < 5 || durationMinutes > 240) {
                throw new Error('请检查每个时段的星期、开始时间和课程时长（5-240 分钟）。');
            }
            return { weekday, startTime, durationMinutes };
        });
    }

    function setCourseDuration(courseName, durationMinutes) {
        courseDurationMap[courseName] = normalizeDurationMinutes(durationMinutes);
    }

    function hasCourseName(courseName, ignoredEl) {
        return Array.from(containerEl.children).some(el => {
            return el !== ignoredEl && getCourseNameFromElement(el) === courseName;
        });
    }

    function updateScheduledCourse(oldName, newName, durationMinutes) {
        const normalizedDuration = normalizeDurationMinutes(durationMinutes);
        calendar.getEvents().forEach(event => {
            if (event.title !== oldName) {
                return;
            }
            event.setProp('title', newName);
            if (event.start) {
                event.setEnd(addMinutes(event.start, normalizedDuration));
            }
        });
    }

    function serializeSchedule() {
        const calendarEvents = calendar.getEvents().map(serializeCalendarEvent);
        const availableCourses = Array.from(containerEl.children).map(el => ({
            title: getCourseNameFromElement(el),
            durationMinutes: getDurationFromElement(el)
        }));

        return {
            version: 2,
            updatedAt: new Date().toISOString(),
            calendarEvents,
            availableCourses,
            courseColorMap,
            courseDurationMap
        };
    }

    function saveState() {
        if (isLoadingData) {
            return;
        }
        try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(serializeSchedule()));
        } catch (error) {
            console.warn('自动保存失败:', error);
        }
    }

    function getSavedScheduleData() {
        try {
            const savedData = localStorage.getItem(STORAGE_KEY) || localStorage.getItem(LEGACY_STORAGE_KEY);
            if (!savedData) {
                return null;
            }
            return JSON.parse(savedData);
        } catch (error) {
            console.warn('读取本地自动保存失败:', error);
            return null;
        }
    }

    function loadSavedState() {
        try {
            const savedData = getSavedScheduleData();
            if (!savedData) {
                return false;
            }
            loadData(savedData, { persist: false });
            console.log('已恢复本地自动保存的课程表。');
            return true;
        } catch (error) {
            console.warn('恢复本地课程表失败:', error);
            return false;
        }
    }

    addCourseBtn.addEventListener('click', function() {
        resetCourseForm();
        courseNameInput.focus();
    });

    addOccurrenceBtn.addEventListener('click', function() {
        createOccurrenceRow();
    });

    addCourseForm.addEventListener('submit', function(event) {
        event.preventDefault();
        const trimmedName = courseNameInput.value.trim();
        if (!trimmedName) {
            alert('请输入课程名称。');
            courseNameInput.focus();
            return;
        }
        if (hasCourseName(trimmedName)) {
            alert('该课程已存在，请直接双击课程列表中的课程进行修改。');
            return;
        }

        let occurrences;
        try {
            occurrences = readOccurrenceRows();
        } catch (error) {
            alert(error.message);
            return;
        }

        const color = assignOrGetCourseColor(trimmedName);
        setCourseDuration(trimmedName, occurrences[0].durationMinutes);
        occurrences.forEach(occurrence => {
            const start = buildReferenceDate(occurrence.weekday, occurrence.startTime);
            const end = addMinutes(start, occurrence.durationMinutes);
            calendar.addEvent({
                title: trimmedName,
                start,
                end,
                durationMinutes: occurrence.durationMinutes,
                backgroundColor: color,
                borderColor: color,
                textColor: getContrastingTextColor(color)
            });
        });

        containerEl.appendChild(createCourseElement(trimmedName, color, occurrences[0].durationMinutes));
        saveState();
        resetCourseForm();
        alert(`课程“${trimmedName}”已添加，共安排 ${occurrences.length} 个时段。`);
    });

    containerEl.addEventListener('dblclick', function(e) {
      const courseEl = e.target.closest('.fc-event');
      if (courseEl) {
        const oldName = getCourseNameFromElement(courseEl);
        const oldDuration = getDurationFromElement(courseEl);
        const newName = prompt('请修改课程名称:', oldName);
        if (newName && newName.trim() !== '') {
          const trimmedNewName = newName.trim();
          if (trimmedNewName !== oldName && hasCourseName(trimmedNewName, courseEl)) {
            alert('该课程已存在，请使用另一个课程名称。');
            return;
          }
          const newDuration = promptCourseDuration(oldDuration);
          if (newDuration === null) {
            return;
          }
          if (trimmedNewName !== oldName) {
            courseColorMap[trimmedNewName] = courseColorMap[oldName];
            delete courseDurationMap[oldName];
            delete courseColorMap[oldName];
          }
          const newColor = assignOrGetCourseColor(trimmedNewName);
          setCourseDuration(trimmedNewName, newDuration);

          courseEl.dataset.courseName = trimmedNewName;
          courseEl.dataset.durationMinutes = newDuration;
          courseEl.querySelector('.course-name').innerText = trimmedNewName;
          courseEl.querySelector('.course-duration').innerText = `${newDuration} 分钟`;
          courseEl.style.backgroundColor = newColor;
          courseEl.style.borderColor = newColor;
          courseEl.dataset.color = newColor;
          updateScheduledCourse(oldName, trimmedNewName, newDuration);
          saveState();
        }
      }
    });

    // --- 导入/导出逻辑 ---
    exportBtn.addEventListener('click', function() {
        const dataToExport = JSON.stringify(serializeSchedule(), null, 2);
        const blob = new Blob([dataToExport], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = '课程表.json';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
    });

    // --- 【核心重构】导入数据处理流程 ---
    function loadData(data, options = {}) {
        const shouldPersist = options.persist !== false;
        if (!data.calendarEvents || !data.availableCourses) {
            throw new Error('无效的文件格式');
        }

        isLoadingData = true;
        try {
            // 1. 清理当前状态
            calendar.removeAllEvents();
            containerEl.innerHTML = '';
            courseColorMap = {};
            courseDurationMap = {};

            // 2. 收集所有唯一的课程名称
            const allCourseNames = new Set([
                ...data.availableCourses.map(c => c.title.trim()),
                ...data.calendarEvents.map(e => e.title.trim())
            ]);

            // 3. 优先恢复导入文件中的颜色，再为新增课程分配不重复的颜色
            allCourseNames.forEach(name => {
                const importedColor = normalizeHexColor(data.courseColorMap?.[name]);
                if (importedColor && !Object.values(courseColorMap).includes(importedColor)) {
                    courseColorMap[name] = importedColor;
                }
            });
            allCourseNames.forEach(name => {
                assignOrGetCourseColor(name);
            });

            data.availableCourses.forEach(courseData => {
                const name = courseData.title.trim();
                const savedDuration = courseData.durationMinutes || data.courseDurationMap?.[name] || data.settings?.durationMinutes;
                if (savedDuration) {
                    setCourseDuration(name, savedDuration);
                }
            });
            data.calendarEvents.forEach(eventData => {
                const name = eventData.title.trim();
                if (!courseDurationMap[name]) {
                    const start = getEventStartDate(eventData);
                    const end = getEventEndDate(eventData, start, DEFAULT_DURATION_MINUTES);
                    const eventDuration = start && end ? Math.round((end - start) / 60000) : null;
                    const savedDuration = data.courseDurationMap?.[name] || eventDuration || data.settings?.durationMinutes;
                    setCourseDuration(name, savedDuration);
                }
            });
            allCourseNames.forEach(name => {
                if (!courseDurationMap[name]) {
                    setCourseDuration(name, DEFAULT_DURATION_MINUTES);
                }
            });

            // 4. 使用这个全新的、干净的颜色映射来渲染页面
            data.calendarEvents.forEach(eventData => {
                const name = eventData.title.trim();
                const color = courseColorMap[name];
                const durationMinutes = courseDurationMap[name] || DEFAULT_DURATION_MINUTES;
                const normalizedEvent = normalizeCalendarEvent(eventData, durationMinutes);
                if (normalizedEvent) {
                    calendar.addEvent({
                        ...normalizedEvent,
                        backgroundColor: color,
                        borderColor: color,
                        textColor: getContrastingTextColor(color)
                    });
                }
            });
            data.availableCourses.forEach(courseData => {
                const name = courseData.title.trim();
                const color = courseColorMap[name];
                const durationMinutes = courseDurationMap[name] || DEFAULT_DURATION_MINUTES;
                const courseEl = createCourseElement(name, color, durationMinutes);
                containerEl.appendChild(courseEl);
            });

            const firstEventStart = getFirstEventStartDate(data.calendarEvents);
            if (firstEventStart) {
                calendar.gotoDate(firstEventStart);
            }
        } finally {
            isLoadingData = false;
        }

        if (shouldPersist) {
            saveState();
        }
    }

    importFileEl.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function(event) {
            try {
                const data = JSON.parse(event.target.result);
                loadData(data);
                alert('课表导入成功！');
            } catch (error) {
                alert('导入失败: ' + error.message);
            } finally {
                e.target.value = '';
            }
        };
        reader.readAsText(file);
    });

    // --- 保存为图片逻辑 ---
    saveImageBtn.addEventListener('click', function() {
      saveImageBtn.innerText = '正在生成...';
      saveImageBtn.disabled = true;
      html2canvas(document.getElementById('calendar-container'), {
          backgroundColor: '#ffffff',
          scale: 2
      }).then(canvas => {
          const a = document.createElement('a');
          a.href = canvas.toDataURL('image/png');
          a.download = '我的课程表.png';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          saveImageBtn.innerText = '存为图片';
          saveImageBtn.disabled = false;
      }).catch(err => {
          alert('图片生成失败！');
          console.error(err);
          saveImageBtn.innerText = '存为图片';
          saveImageBtn.disabled = false;
      });
    });


    // --- FullCalendar 日历配置 ---
    var calendar = new FullCalendar.Calendar(calendarEl, {
      headerToolbar: { left: '', center: '', right: '' },
      slotMinTime: '08:00:00',
      slotMaxTime: '22:00:00',
      slotDuration: '00:30:00',
      snapDuration: '00:01:00',
      slotLabelInterval: '00:30:00',
      slotLabelFormat: { hour: 'numeric', minute: '2-digit', hour12: false },
      dayHeaderFormat: { weekday: 'long' },
      initialView: 'timeGridWeek',
      initialDate: REFERENCE_WEEK_START,
      firstDay: 1,
      locale: 'zh-cn',
      editable: false,
      eventStartEditable: false,
      eventDurationEditable: false,
      eventOverlap: true,
      droppable: false,
      allDaySlot: false,
      nowIndicator: false,
      events: [],

      eventClick: function(info) {
        if (confirm("要删除课程 '" + info.event.title + "' 吗?")) {
          info.event.remove();
        }
      },
      eventAdd: saveState,
      eventChange: saveState,
      eventRemove: saveState
    });

    calendar.render();
    createOccurrenceRow();

    // 初始化页面时，为默认课程分配颜色
    function initializeCourseColors() {
      const courseElements = containerEl.querySelectorAll('.fc-event');
      courseElements.forEach(el => {
        const courseName = getCourseNameFromElement(el);
        const durationMinutes = getDurationFromElement(el);
        const color = assignOrGetCourseColor(courseName);
        setCourseDuration(courseName, durationMinutes);
        el.style.backgroundColor = color;
        el.style.borderColor = color;
        el.style.color = getContrastingTextColor(color);
        el.dataset.color = color;
        el.dataset.courseName = courseName;
        el.dataset.durationMinutes = durationMinutes;
        if (!el.querySelector('.course-name')) {
          el.innerHTML = '';
          const nameEl = document.createElement('span');
          nameEl.className = 'course-name';
          nameEl.innerText = courseName;
          const durationEl = document.createElement('span');
          durationEl.className = 'course-duration';
          durationEl.innerText = `${durationMinutes} 分钟`;
          el.appendChild(nameEl);
          el.appendChild(durationEl);
        }
      });
    }

    initializeCourseColors();

    async function autoLoadSchedule() {
        try {
            const response = await fetch('课程表.json');
            if (!response.ok) {
                console.log('未找到 "课程表.json" 文件，尝试加载本地保存的课程表。');
                return false;
            }
            const data = await response.json();
            loadData(data);
            console.log('成功自动导入 "课程表.json"！');
            return true;
        } catch (error) {
            console.error('自动导入失败:', error);
            return false;
        }
    }

    const restoredFromLocal = loadSavedState();
    if (!restoredFromLocal) {
        autoLoadSchedule().then(loadedFromServer => {
            if (!loadedFromServer) {
                saveState();
            }
        });
    }
  });
</script>

</body>
